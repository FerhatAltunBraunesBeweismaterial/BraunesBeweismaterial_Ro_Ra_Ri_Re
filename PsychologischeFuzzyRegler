const A=new THREE.Vector3(),M=new THREE.Vector3(),P=new THREE.Vector3(),SIDE=new THREE.Vector3(),DIR=new THREE.Vector3(),UP=new THREE.Vector3(0,1,0);
function moveTentacle(t,a,target,time,wob){
  M.copy(a).add(target).multiplyScalar(.5);
  M.y-=.6;
  DIR.copy(target).sub(a);
  SIDE.crossVectors(DIR,UP);
  if(SIDE.lengthSq()<1e-6)SIDE.set(1,0,0);
  SIDE.normalize();
  M.addScaledVector(SIDE,t.index%2?.12:-.12);
  for(let k=0;k<=TSEG;k++){
    const u=k/TSEG,w=1-u;
    P.set(
      w*w*a.x+2*w*u*M.x+u*u*target.x,
      w*w*a.y+2*w*u*M.y+u*u*target.y,
      w*w*a.z+2*w*u*M.z+u*u*target.z
    );
    const off=Math.sin(u*7-time*2.2+t.index*.25)*.3*wob*Math.sin(u*Math.PI);
    P.addScaledVector(SIDE,off);
    P.y+=off*.4;
    t.segments[k].position.copy(P);
  }
}

