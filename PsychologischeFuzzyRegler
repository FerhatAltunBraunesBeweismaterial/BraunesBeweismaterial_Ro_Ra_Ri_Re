const pts=[[-1.15,.75],[1.15,.75],[1.15,-.75],[-1.15,-.75]];
function createWavePlane(i,w=2.3,d=1.55){
  const geo=new THREE.PlaneGeometry(w,d,40,30);
  const uniforms={
    uTime:{value:0},
    uCol:{value:new THREE.Color(COLORS[i])},
    uCol2:{value:new THREE.Color(COLORS[(i+1)%4])},
    uSrc:{value:new THREE.Vector2(...pts[i])}
  };
  const material=new THREE.ShaderMaterial({
    uniforms,transparent:true,side:THREE.DoubleSide,depthWrite:false,
    vertexShader:`uniform float uTime;uniform vec2 uSrc;varying vec2 vUv;varying float vD;void main(){vUv=uv;vec3 p=position;float d=length(p.xy-uSrc);p.z+=.16*sin(d*7.0-uTime*3.0)*exp(-d*.7)+.02*sin(p.x*8.0+uTime*2.5);vD=p.z;gl_Position=projectionMatrix*modelViewMatrix*vec4(p,1.0);}`,
    fragmentShader:`uniform float uTime;uniform vec3 uCol,uCol2;varying vec2 vUv;varying float vD;void main(){float g=.5+.5*sin(vUv.x*5.0+vUv.y*4.0+uTime*.7);vec3 col=mix(uCol,uCol2,g*.55);float gr=max(step(.97,fract(vUv.x*12.0)),step(.97,fract(vUv.y*9.0)));col=mix(col,vec3(1.),gr*.2);col+=abs(vD)*1.2;gl_FragColor=vec4(col,.52);}`
  });
  const mesh=new THREE.Mesh(geo,material);
  mesh.rotation.x=-Math.PI/2;
  scene.add(mesh);
  return {mesh,uniforms};
}

