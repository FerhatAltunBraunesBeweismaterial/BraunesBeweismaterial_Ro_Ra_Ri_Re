    {k:"Re",v:r.Re,c:"#4be07a"}
  ];
  document.getElementById("cmd"+i).innerHTML=parts.map((pt,idx)=>
    `<span style="color:${pt.c}" class="${idx===activePh?'hl':''}">${pt.v}</span>`
  ).join(" → ");
}

function getReTargetPos(reStr){
  if(/Tuer|Fenster/.test(reStr)) return targetObjects.Tuer.pos;
  if(/Tisch|Laptop|Buch|Stift|Handy|Tasse|Schluessel|Tasche/.test(reStr)) return targetObjects.Tisch.pos;
  if(/Stuhl|Sofa/.test(reStr)) return targetObjects.Stuhl.pos;
  if(/Lichtschalter|Ampel|Baum|Wegweiser|Auto|Ball|Lenkrad|Treppe/.test(reStr)) return targetObjects.Lichtschalter.pos;
  return SING;
}

function startPersonSequence(i, rowNr){
  const p=people[i];
  const r=COMMANDS.find(x=>x.Nr===rowNr)||selectedRow(i);
  document.getElementById("sel"+i).value=String(r.Nr);
  p.activeRow=r;
  p.running=true;
  p.cmdPhase=0;
  p.phaseTimer=0;
  document.getElementById("card"+i).classList.add("running");

  const reTarget=getReTargetPos(r.Re);
  const angleOffset=(i-1)*0.75 + (r.Nr%5)*0.2;
  if(/vor|Tuer|Tisch|Stuhl|Lichtschalter|Ampel|Baum|Auto|Sofa|Laptop|Buch|Ball/.test(r.Ro+" "+r.Re)){
    const pull = /Re/.test(r.Re) ? 0.55 : 0.35;
    p.targetX = clamp(p.curX*(1-pull) + reTarget.x*pull + Math.sin(angleOffset)*0.9, -4.2, 4.2);
    p.targetZ = clamp(p.curZ*(1-pull) + reTarget.z*pull + Math.cos(angleOffset)*0.9, -4.2, 4.2);
  } else {
    p.wpAngle += 0.65 + (i*0.2);
    const radius = 2.2 + (r.Nr%3)*0.55;
    p.targetX = clamp(Math.cos(p.wpAngle)*radius, -4.2, 4.2);
    p.targetZ = clamp(Math.sin(p.wpAngle)*radius, -4.2, 4.2);
  }
  showCommands(i, 0);
}

// Globale Phasensteuerung & Auto-Zyklus
let phase=-1,elapsed=0,paused=false,autoCycle=true;

function setPhase(ph){
  phase=ph;
  document.getElementById("route").textContent=`Quelle ${PHASES[ph]} → Senke ${PHASES[(ph+2)%4]}`;
  document.getElementById("state").textContent=[
    "Ro · Motorische Ausführung & Raumbewegung",
    "Ra · Kognitive Verarbeitung (Gehirnareale)",
    "Ri · Sensorische Reizaufnahme & Fokus",
    "Re · Zielobjekt-Ausrichtung & Entladung"
  ][ph];
  for(let i=0;i<4;i++) document.getElementById("c"+i).classList.toggle("on",i===ph);

  // Jede Person behält exakt ihre eine Wellenebene
  personPlanes.forEach((p,i)=>{
    p.uniforms.uCol.value.setHex(COLORS[(ph+i)%4]);
    p.uniforms.uCol2.value.setHex(COLORS[(ph+i+1)%4]);
    p.uniforms.uSrc.value.set(...pts[(ph+i)%4]);
  });

  // Die 4. Wellenebene gehört zur Quaderstruktur
  quaderPlane.uniforms.uCol.value.setHex(COLORS[(ph+3)%4]);
  quaderPlane.uniforms.uCol2.value.setHex(COLORS[ph]);
  quaderPlane.uniforms.uSrc.value.set(...pts[3]);

  tentacles.forEach(t=>{
    t.material.color.setHex(COLORS[ph]);
    t.material.emissive.setHex(COLORS[ph]);
  });
  qedge.material.color.setHex(COLORS[ph]);
  lines.forEach((l,i)=>l.material.color.setHex(COLORS[(ph+i)%4]));
  document.getElementById("fill").style.background="#"+COLORS[ph].toString(16).padStart(6,"0");
}

document.getElementById("autoRun").onclick=(e)=>{
  autoCycle=!autoCycle;
  e.target.textContent=autoCycle?"Auto-Zyklus: AN":"Auto-Zyklus: AUS";
  e.target.classList.toggle("activeToggle",autoCycle);
};
document.getElementById("runAll").onclick=()=>{
  people.forEach((p,i)=>startPersonSequence(i, Number(document.getElementById("sel"+i).value)));
};
document.getElementById("pause").onclick=()=>{
  paused=!paused;
  document.getElementById("pause").textContent=paused?"Fortsetzen":"Pause";
};
document.getElementById("step").onclick=()=>{
  elapsed=(Math.floor(elapsed/PH)+1)*PH+.01;
  people.forEach((p,i)=>{
    if(p.running){
      p.cmdPhase=(p.cmdPhase+1)%4;
      p.phaseTimer=0;
      showCommands(i,p.cmdPhase);
    }
  });
};
document.getElementById("reset").onclick=()=>{
  elapsed=0;theta=.65;phi=.95;rad=12.0;
  people.forEach((p,i)=>{
    p.curX=p.homeX;p.curZ=p.homeZ;p.targetX=p.homeX;p.targetZ=p.homeZ;
    p.g.position.set(p.homeX,0,p.homeZ);
    p.running=false;
    document.getElementById("card"+i).classList.remove("running");
    document.getElementById("badge"+i).textContent="Bereit";
    updateLabel(p.cmdTag,"Bereit","#ffffff");
  });
};

// Kamera-Steuerung
let theta=.65,phi=.95,rad=12.0,dragging=false,lx=0,ly=0,pinch=0;
const el=renderer.domElement,ptrs=new Map();
el.addEventListener("pointerdown",e=>{ptrs.set(e.pointerId,{x:e.clientX,y:e.clientY});el.setPointerCapture(e.pointerId);dragging=true;lx=e.clientX;ly=e.clientY});
el.addEventListener("pointerup",e=>{ptrs.delete(e.pointerId);if(!ptrs.size)dragging=false;pinch=0});
el.addEventListener("pointercancel",e=>{ptrs.delete(e.pointerId);if(!ptrs.size)dragging=false;pinch=0});
el.addEventListener("pointermove",e=>{
  if(!ptrs.has(e.pointerId))return;
  ptrs.set(e.pointerId,{x:e.clientX,y:e.clientY});
  if(ptrs.size===2){
    const [a,b]=[...ptrs.values()],d=Math.hypot(a.x-b.x,a.y-b.y);
    if(pinch)rad=clamp(rad*pinch/d,6,22);
    pinch=d;return;
  }
  theta-=(e.clientX-lx)*.006;
  phi=clamp(phi-(e.clientY-ly)*.005,.25,1.42);
  lx=e.clientX;ly=e.clientY;
});
el.addEventListener("wheel",e=>rad=clamp(rad+e.deltaY*.01,6,22),{passive:true});
addEventListener("resize",()=>{renderer.setSize(innerWidth,innerHeight);camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix()});

// Initiale Sequenzen starten
people.forEach((p,i)=>startPersonSequence(i, i*15+1));

let last=performance.now();
function tick(now){
  requestAnimationFrame(tick);
  const dt=Math.min(.05,(now-last)/1000);
  last=now;
  if(!paused) elapsed+=dt;

  const ph=Math.floor(elapsed/PH)%4, k=(elapsed%PH)/PH;
  if(ph!==phase) setPhase(ph);

  const phaseDur = 2.4;
  let hudSummary = [];

  people.forEach((p,i)=>{
    if(!paused && autoCycle && !p.running){
      const nextNr = (Number(document.getElementById("sel"+i).value) % COMMANDS.length) + 1;
      startPersonSequence(i, nextNr);
    }

    if(!paused && p.running && p.activeRow){
      p.phaseTimer += dt;
      if(p.phaseTimer >= phaseDur){
        p.phaseTimer -= phaseDur;
        p.cmdPhase++;
        if(p.cmdPhase > 3){
          p.running = false;
          document.getElementById("card"+i).classList.remove("running");
          document.getElementById("badge"+i).textContent = "Fertig";
        } else {
          showCommands(i, p.cmdPhase);
        }
      }
    }

    const r = p.activeRow;
    const cPh = p.running ? p.cmdPhase : -1;
    const phProgress = p.running ? clamp(p.phaseTimer / phaseDur, 0, 1) : 0;

    // 1. Kontinuierliche Raumbewegung
    let dx = p.targetX - p.curX;
    let dz = p.targetZ - p.curZ;
    const dist = Math.hypot(dx, dz);
    let isWalking = false;

    if(!paused && dist > 0.06){
      isWalking = true;
      const speed = (cPh === 0 ? 1.45 : 0.95);
      const step = Math.min(dist, speed * dt);
      p.curX += (dx / dist) * step;
      p.curZ += (dz / dist) * step;
      p.walkCycle += dt * (speed * 6.5);
    } else if (!paused && autoCycle) {
      p.wpAngle += dt * (0.35 + i * 0.08);
      const radPatrol = 2.3 + i * 0.45;
      p.targetX = Math.cos(p.wpAngle + i * 2.1) * radPatrol;
      p.targetZ = Math.sin(p.wpAngle + i * 2.1) * radPatrol;
    }

    p.g.position.set(p.curX, 0, p.curZ);

    let desiredYaw = p.base;
    if(cPh === 3 && r){
      const objPos = getReTargetPos(r.Re);
      desiredYaw = Math.atan2(objPos.x - p.curX, objPos.z - p.curZ);
    } else if(dist > 0.08){
      desiredYaw = Math.atan2(dx, dz);
    }
    let diffYaw = desiredYaw - p.g.rotation.y;
    while(diffYaw > Math.PI) diffYaw -= Math.PI*2;
    while(diffYaw < -Math.PI) diffYaw += Math.PI*2;
    p.g.rotation.y += diffYaw * Math.min(1, dt * 5);

    p.bodyPivot.rotation.set(0,0,0);
    p.bodyPivot.position.y = 0.78 + (isWalking ? Math.abs(Math.sin(p.walkCycle))*0.045 : 0);
    p.headPivot.rotation.set(0,0,0);
    p.headPivot.position.set(0,0.82,0);
    p.shoulders[0].rotation.set(0,0,-0.08);
    p.shoulders[1].rotation.set(0,0,0.08);
    p.raAura.material.opacity = 0;
    p.riCone.material.opacity = 0;

    if(isWalking){
      const swing = Math.sin(p.walkCycle) * 0.55;
      p.hips[0].rotation.x = swing;
      p.hips[1].rotation.x = -swing;
      p.shoulders[0].rotation.x = -swing * 0.65;
      p.shoulders[1].rotation.x = swing * 0.65;
    } else {
      p.hips[0].rotation.x *= 0.85;
      p.hips[1].rotation.x *= 0.85;
    }

    // 2. Spezifische Ausführung der Ro / Ra / Ri / Re Kommandos
    if(p.running && r){
      const wave = Math.sin(phProgress * Math.PI);
      const pulse = 0.5 + 0.5 * Math.sin(elapsed * 8);

      if(cPh === 0){
        const ro = r.Ro;
        updateLabel(p.cmdTag, ro, "#ff5b60");
        document.getElementById("badge"+i).textContent = "Ro";

        const isLinks = /links/.test(ro);
        const isRechts = /rechts/.test(ro);
        const isVor = /vor/.test(ro);
        const isZurueck = /zurueck/.test(ro);
        const isHoch = /hoch|Strecken/.test(ro);
        const isRunter = /runter|Beugen/.test(ro);

        if(/Kopf/.test(ro)){
          if(isVor) p.headPivot.position.z = 0.14 * wave;
          if(isZurueck) p.headPivot.position.z = -0.12 * wave;
          if(isHoch) p.headPivot.rotation.x = -0.45 * wave;
          if(isRunter) p.headPivot.rotation.x = 0.50 * wave;
          if(isLinks) p.headPivot.rotation.y = 0.65 * wave;
          if(isRechts) p.headPivot.rotation.y = -0.65 * wave;
        } else if(/Rumpf/.test(ro)){
          if(isRunter) p.bodyPivot.rotation.x = 0.45 * wave;
          if(isHoch) p.bodyPivot.rotation.x = -0.28 * wave;
          if(isLinks) p.bodyPivot.rotation.y = 0.55 * wave;
          if(isRechts) p.bodyPivot.rotation.y = -0.55 * wave;
          if(isVor) p.bodyPivot.position.z = 0.18 * wave;
          if(isZurueck) p.bodyPivot.position.z = -0.18 * wave;
        } else if(/Schulter|Arm|Hand/.test(ro)){
          const idx = isLinks ? 0 : (isRechts ? 1 : 0);
          const sgn = idx === 0 ? -1 : 1;
          p.shoulders[idx].rotation.x = (isVor ? -1.2 : isZurueck ? 0.7 : -0.8) * wave;
          p.shoulders[idx].rotation.z = sgn * (isHoch ? 1.3 : 0.45) * wave;
        } else if(/Bein/.test(ro)){
          const idx = isLinks ? 0 : 1;
          p.hips[idx].rotation.x = (isVor || isHoch ? -0.95 : 0.6) * wave;
        }
      }
      else if(cPh === 1){
        updateLabel(p.cmdTag, r.Ra, "#ffffff");
        document.getElementById("badge"+i).textContent = "Ra";
        p.raAura.material.opacity = 0.35 + 0.55 * pulse;
        p.raAura.scale.setScalar(1 + 0.35 * pulse);
        p.headPivot.rotation.z = Math.sin(elapsed * 4 + i) * 0.12;
        p.shoulders[1].rotation.x = -0.9 * wave;
        p.shoulders[1].rotation.z = -0.35 * wave;
      }
      else if(cPh === 2){
        updateLabel(p.cmdTag, r.Ri, "#ffe14a");
        document.getElementById("badge"+i).textContent = "Ri";
        p.riCone.material.opacity = 0.25 + 0.35 * pulse;
        p.riCone.scale.set(1 + 0.2*pulse, 1 + 0.3*wave, 1 + 0.2*pulse);
        p.headPivot.rotation.y = Math.sin(phProgress * Math.PI * 2) * 0.55;
        p.headPivot.rotation.x = -0.15 * wave;
      }
      else if(cPh === 3){
        updateLabel(p.cmdTag, r.Re, "#4be07a");
        document.getElementById("badge"+i).textContent = "Re";
        p.shoulders[1].rotation.x = -1.35 * wave;
        p.shoulders[1].rotation.z = -0.15 * wave;
        p.bodyPivot.rotation.x = 0.18 * wave;
      }

      const activeStr = [r.Ro, r.Ra, r.Ri, r.Re][cPh];
      hudSummary.push(`<b>${p.name}:</b> ${activeStr}`);
    }
  });

  if(hudSummary.length){
    document.getElementById("activeCmdBox").innerHTML = hudSummary.join(" &nbsp;|&nbsp; ");
  }

  // Genau 1 Wellenebene direkt über dem Kopf der jeweiligen Person
  personPlanes.forEach((p,i)=>{
    p.uniforms.uTime.value=elapsed;
    const personObj = people[i].g.position;
    p.mesh.position.set(personObj.x, 2.85 + Math.sin(elapsed*.7+i)*.045, personObj.z);
    p.mesh.rotation.z=Math.sin(elapsed*.25+i)*.035;
  });

  // Singularität & Verbindungslinien
  sing.scale.setScalar(1+.12*Math.sin(elapsed*3));
  halo.scale.setScalar(1+.25*Math.sin(elapsed*1.7));
  lines.forEach((l,i)=>{
    const pos=l.geometry.attributes.position, pg=people[i].g.position;
    pos.setXYZ(0,pg.x,2.15,pg.z);
    pos.setXYZ(1,SING.x,SING.y,SING.z);
    pos.needsUpdate=true;
    l.material.opacity=.22+.32*(.5+.5*Math.sin(elapsed*2+i));
  });

  // Quaderstruktur mit ihren 4 Tentakeln & der 4. Ebene direkt darunter am Tentakelansatz
  const bob=Math.sin(elapsed*.8)*.1;
  quader.position.y=QPOS.y+bob;
  quaderPlane.uniforms.uTime.value=elapsed;
  quaderPlane.mesh.position.set(QPOS.x, QPOS.y - 0.55 + bob, QPOS.z);
  quaderPlane.mesh.rotation.z=Math.sin(elapsed*.25+3)*.035;

  const dest=[
    new THREE.Vector3(people[0].curX, 1.3, people[0].curZ),
    SING,
    new THREE.Vector3(people[1].curX, 1.3, people[1].curZ),
    new THREE.Vector3(people[2].curX, 1.3, people[2].curZ)
  ];
  const amount=ph===0?0:ph===1?ease(k):ph===2?1:1-ease(k);
  tentacles.forEach((t,i)=>{
    A.copy(anchors[i]);
    A.y+=bob;
    const free=new THREE.Vector3(
      A.x+(i-1.5)*.3+Math.sin(elapsed*.9+i*1.7)*.6,
      1.2+Math.sin(elapsed*1.1+i)*.4,
      A.z+1+Math.cos(elapsed*.7+i*2)*.7
    );
    const target=free.lerp(dest[i],amount);
    moveTentacle(t,A,target,elapsed,1-amount*.65);
    t.segments.forEach((sg,j)=>sg.scale.setScalar(1+.15*Math.sin(elapsed*2+j*.5+i)));
  });

  if(!dragging) theta+=dt*.035;
  const tg=new THREE.Vector3(0,1.8,-.3);
  camera.position.set(
    tg.x+rad*Math.sin(phi)*Math.sin(theta),
    tg.y+rad*Math.cos(phi),
    tg.z+rad*Math.sin(phi)*Math.cos(theta)
  );
  camera.lookAt(tg);
  document.getElementById("fill").style.width=(elapsed%PH)/PH*100+"%";
  renderer.render(scene,camera);
}
requestAnimationFrame(tick);
})();
</script></body></html>
