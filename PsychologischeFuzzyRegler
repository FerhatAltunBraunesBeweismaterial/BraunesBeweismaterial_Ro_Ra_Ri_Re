function label(text,w,h,color="#f2f4ff"){
  const c=document.createElement("canvas");
  c.width=640;c.height=128;
  const x=c.getContext("2d");
  x.fillStyle="rgba(9,13,24,0.88)";
  x.fillRect(0,0,640,128);
  x.strokeStyle="rgba(255,255,255,0.4)";
  x.lineWidth=3;
  x.strokeRect(2,2,636,124);
  x.fillStyle=color;
  x.font="bold 25px system-ui";
  x.textAlign="center";
  x.textBaseline="middle";
  x.fillText(text,320,64);
  const tex=new THREE.CanvasTexture(c);
  const s=new THREE.Sprite(new THREE.SpriteMaterial({map:tex,transparent:true,depthTest:false}));
  s.scale.set(w,h,1);
  s.userData={canvas:c,ctx:x,tex,lastText:""};
  return s;
}

function updateLabel(sprite,text,color="#f2f4ff"){
  const d=sprite.userData;
  if(d.lastText===text+color)return;
  d.lastText=text+color;
  const x=d.ctx;
  x.clearRect(0,0,640,128);
  x.fillStyle="rgba(9,13,24,0.9)";
  x.fillRect(0,0,640,128);
  x.strokeStyle=color;
  x.lineWidth=4;
  x.strokeRect(2,2,636,124);
  x.fillStyle=color;
  x.font="bold 23px system-ui";
  x.textAlign="center";
  x.textBaseline="middle";
  const disp=text.length>42?text.slice(0,40)+"…":text;
  x.fillText(disp,320,64);
  d.tex.needsUpdate=true;
}

