function sendPulse(opIdx, customCmd) {
  const col = C[opIdx];
  const src = [QA, QB, QC][pk % 3];
  const m = new THREE.Mesh(new THREE.SphereGeometry(0.26, 16, 12), new THREE.MeshBasicMaterial({ color: col }));
