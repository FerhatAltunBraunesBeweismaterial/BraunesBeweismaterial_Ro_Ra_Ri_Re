    rg.attributes.position.needsUpdate = true;
    rl.material.opacity = 0.25 + flash * 0.6;
  }

  // Tentakel-Link greift vom Quader zur ri_Person
  const hp = new THREE.Vector3(px, 1.55, pz);
  for (let i = links.length - 1; i >= 0; i--) {
    const l = links[i];
    l.a += dt;
    const s = l.src.Q.position;
    const e = s.clone().lerp(hp, Math.min(1, l.a * 2.5));
    const d = e.clone().sub(s);
    const L = Math.max(d.length(), 0.01);
    l.m.position.copy(s).add(e).multiplyScalar(0.5);
    const w = 1 + Math.sin(t * 30) * 0.3;
    l.m.scale.set(w, L, w);
    l.m.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), d.normalize());
    l.m.material.opacity = Math.max(0, Math.min(1, (2.2 - l.a) / 0.7));
    if (l.a > 2.2) {
      sc.remove(l.m);
      links.splice(i, 1);
    }
  }

  // Kamera-Positionierung
  if (!drag) az += dt * 0.025;
  const rad = cam.aspect < 1 ? 24 : 16.5;
  cam.position.set(rad * Math.sin(az), rad * 0.48, rad * Math.cos(az));
  cam.lookAt(3.2, 1.1, 0.2);

  R.render(sc, cam);
  requestAnimationFrame(loop);
}

window.onload = function () {
