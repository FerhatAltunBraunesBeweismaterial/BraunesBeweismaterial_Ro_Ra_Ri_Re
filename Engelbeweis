function applyCommand(opIdx, cmdText) {
  const op = N[opIdx];
  const cssCol = CSS_C[opIdx];
  activeState.op = op;
  activeState.cmd = cmdText;
  activeState.timer = 2.6;

  // Reset zielgerichtete Posen
  activeState.headRotX = 0; activeState.headRotY = 0;
  activeState.headPosZ = 0; activeState.headPosY = 0.46;
  activeState.torsoRotX = 0; activeState.torsoRotY = 0; activeState.torsoPosY = 0.72;
  activeState.armLRotX = 0; activeState.armLRotZ = 0;
  activeState.armRRotX = 0; activeState.armRRotZ = 0;
  activeState.legLRotX = 0; activeState.legRRotX = 0;
  activeState.moveSpeed = 0.75;
  activeState.reachTarget = false;

  let desc = '';

  if (op === 'Ro') {
    const isLeft = cmdText.includes('_links');
    const isRight = cmdText.includes('_rechts');
    const isVor = cmdText.includes('_vor');
    const isZurueck = cmdText.includes('_zurueck');
    const isHoch = cmdText.includes('_hoch');
    const isRunter = cmdText.includes('_runter');
    const isBeugen = cmdText.includes('_Beugen');
    const isStrecken = cmdText.includes('_Strecken');
    const isStopp = cmdText.includes('_Stopp');

    if (isStopp) activeState.moveSpeed = 0;
    if (isVor) activeState.moveSpeed = 1.45;
    if (isZurueck) activeState.moveSpeed = -0.8;

    if (cmdText.includes('Kopf')) {
      if (isLeft) activeState.headRotY = 0.75;
      if (isRight) activeState.headRotY = -0.75;
      if (isVor) activeState.headPosZ = 0.14;
      if (isZurueck) activeState.headPosZ = -0.12;
      if (isHoch) activeState.headPosY = 0.56;
      if (isRunter) activeState.headPosY = 0.38;
      if (isBeugen) activeState.headRotX = 0.55;
      if (isStrecken) activeState.headRotX = -0.45;
      desc = 'Ro-Motorik: Kopf-Kinematik wird auf ri_Person ausgeführt';
    } else if (cmdText.includes('Rumpf')) {
      if (isLeft) activeState.torsoRotY = 0.6;
      if (isRight) activeState.torsoRotY = -0.6;
      if (isHoch) activeState.torsoPosY = 0.84;
      if (isRunter) activeState.torsoPosY = 0.58;
      if (isBeugen) activeState.torsoRotX = 0.5;
      if (isStrecken) activeState.torsoRotX = -0.35;
      desc = 'Ro-Motorik: Rumpf-Translation/Rotation ausgeführt';
    } else if (cmdText.includes('Arm') || cmdText.includes('Hand') || cmdText.includes('Schulter')) {
      const lift = isHoch || isStrecken ? -2.2 : (isVor ? -1.4 : (isBeugen ? -1.1 : -0.5));
      const side = isLeft ? 0.6 : (isRight ? -0.6 : 0);
      if (isLeft) { activeState.armLRotX = lift; activeState.armLRotZ = side; }
      else { activeState.armRRotX = lift; activeState.armRRotZ = side; }
      desc = 'Ro-Motorik: Obere Extremität führt Bewegung aus';
    } else if (cmdText.includes('Bein')) {
      const kick = isVor || isStrecken ? -0.85 : (isZurueck ? 0.65 : (isHoch ? -1.1 : -0.4));
      if (isLeft) activeState.legLRotX = kick;
      else activeState.legRRotX = kick;
      desc = 'Ro-Motorik: Bein-Kinematik aktiviert';
    }
    ht += isLeft ? 0.5 : (isRight ? -0.5 : Math.PI * 0.25);
  } else if (op === 'Ra') {
    brainAuraMat.color.setHex(0xf4f4f4);
    brainAuraMat.opacity = 0.85;
    if (cmdText.includes('Richtungswechsel')) {
      ht += Math.PI;
      turns++;
      desc = 'Ra-Kognition: Richtungswechsel gedacht → Kurs um 180° gedreht';
    } else if (cmdText.includes('Raum_vorstellen') || cmdText.includes('Bewegung_koordinieren')) {
      activeState.headRotY = 0.5;
      activeState.armRRotX = -0.9;
      desc = 'Ra-Kognition: Räumliche Koordination im Lappen aktiv';
    } else if (cmdText.includes('Gedanken_loeschen')) {
      brainAuraMat.opacity = 0.15;
      activeState.moveSpeed = 0.2;
      desc = 'Ra-Kognition: Gedankenspeicher geleert';
    } else {
      activeState.armRRotX = -1.6;
      activeState.headRotX = 0.25;
      desc = 'Ra-Kognition: Aktive Verarbeitung im ' + cmdText.split('_')[1];
    }
  } else if (op === 'Ri') {
    senseRingMat.color.setHex(0xffd93b);
    senseRingMat.opacity = 0.9;
    activeState.headRotY = Math.sin(t * 3) * 0.6;
    if (cmdText.includes('Quelle_orten') || cmdText.includes('Richtung_bestimmen')) {
      ht = Math.atan2(SX - px, SZ - pz);
      desc = 'Ri-Sensorik: Reizquelle (ri_Senke) geortet und anvisiert';
    } else if (cmdText.includes('Fokus_fern')) {
      activeState.headPosZ = 0.15;
      activeState.headRotX = -0.2;
      desc = 'Ri-Sensorik: Fernfokus auf Horizont/Quader ausgerichtet';
    } else if (cmdText.includes('Fokus_nah')) {
      activeState.headRotX = 0.4;
      desc = 'Ri-Sensorik: Nahfokus auf unmittelbare Umgebung';
    } else {
      desc = 'Ri-Sensorik: ' + cmdText.split('_')[1] + '-Reiz wird korreliert';
    }
  } else if (op === 'Re') {
    const objName = cmdText.split('_')[1] || 'Objekt';
    const lobeName = cmdText.split('_').pop() || 'Lappen';
    activeState.reachTarget = true;
    activeState.armRRotX = -1.35;
    activeState.armLRotX = -0.7;
    ht = Math.atan2(targetObj.position.x - px, targetObj.position.z - pz);
    targetObjMat.emissive.setHex(0x3ddc6a);
    targetObjMat.emissiveIntensity = 1.2;
    brainAuraMat.color.setHex(0x3ddc6a);
    brainAuraMat.opacity = 0.75;
    desc = `Re-Entladung: "${objName}" berühren wollen → Entladung im ${lobeName}`;
  }

  activeCmdEl.textContent = cmdText;
  activeCmdEl.style.borderLeftColor = cssCol;
  activeDescEl.textContent = desc;
  updateSprite(cmdText, cssCol);

  execCount++;
  execCountEl.textContent = execCount;
  const item = document.createElement('div');
  item.className = 'log-item';
  item.innerHTML = `<span class="dot" style="background:${cssCol}"></span><span>#${execCount}: ${cmdText}</span>`;
  logListEl.prepend(item);
  if (logListEl.children.length > 30) {
    logListEl.removeChild(logListEl.lastChild);
  }
}

// Re_Quaderstrukturen (QA, QB, QC mit je vier Tentakeln)
function mkQ() {
  const Q = new THREE.Group();
  sc.add(Q);
  Q.add(new THREE.Mesh(new THREE.BoxGeometry(1.6, 0.8, 1.2), new THREE.MeshPhongMaterial({ color: 0x1a1d22, emissive: 0x2a0a10 })));
  const tents = [];
  [[1, 1], [1, -1], [-1, 1], [-1, -1]].forEach((s, k) => {
    const mat = new THREE.MeshPhongMaterial({ color: C[k], emissive: C[k], emissiveIntensity: 0.25 });
    const root = new THREE.Group();
    root.position.set(s[0] * 0.7, -0.4, s[1] * 0.5);
    root.rotation.z = s[0] * 0.6;
    root.rotation.x = -s[1] * 0.5;
    Q.add(root);
    let p = root;
    const segs = [];
    for (let i = 0; i < 6; i++) {
      const j = new THREE.Group();
      p.add(j);
      const m = new THREE.Mesh(new THREE.CylinderGeometry(0.06 - i * 0.007, 0.08 - i * 0.008, 0.5, 6), mat);
      m.position.y = -0.25;
      j.add(m);
      const n = new THREE.Group();
      n.position.y = -0.5;
      j.add(n);
      segs.push(j);
      p = n;
    }
    tents.push(segs);
  });
  return { Q: Q, tents: tents };
}
const QA = mkQ(), QB = mkQ(), QC = mkQ();

