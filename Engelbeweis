  sc.add(m);
  const cmdList = CMDS[N[opIdx]];
  const cmdText = customCmd || cmdList[Math.floor(pk / 4) % cmdList.length];
  pulses.push({ m: m, k: opIdx, col: col, src: src, cmd: cmdText });
  pk++;
}

