const clock = new THREE.Clock();
function wrap(a) {
  while (a > Math.PI) a -= 2 * Math.PI;
  while (a < -Math.PI) a += 2 * Math.PI;
  return a;
}

function loop() {
  const dt = Math.min(clock.getDelta(), 0.05);
  t += dt;

  // Ozean-Wellen & Impulswellen um ri_Senke
  for (let i = 0; i < op.count; i++) {
