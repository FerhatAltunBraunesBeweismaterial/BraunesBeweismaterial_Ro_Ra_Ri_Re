  shake = Math.max(0, shake - dt * 0.8);
  plate.position.x = Math.sin(t * 60) * 0.06 * shake;
  plate.rotation.z = Math.sin(t * 55) * 0.12 * shake;

  // Ri: Relationsschicht aktualisieren
  {
    const P = [QA.Q.position, QB.Q.position, QC.Q.position];
    const S = new THREE.Vector3(SX, 2.5, SZ);
    const H = new THREE.Vector3(px, 1.55, pz);
    const E = [[P[0], P[1]], [P[1], P[2]], [P[2], P[0]], [P[0], S], [P[1], S], [P[2], S], [S, H]];
    const ar = rg.attributes.position.array;
    E.forEach((e, i) => {
      ar[i * 6] = e[0].x; ar[i * 6 + 1] = e[0].y; ar[i * 6 + 2] = e[0].z;
      ar[i * 6 + 3] = e[1].x; ar[i * 6 + 4] = e[1].y; ar[i * 6 + 5] = e[1].z;
