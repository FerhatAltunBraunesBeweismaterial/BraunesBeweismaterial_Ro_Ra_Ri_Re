  targetObj.rotation.y += dt * 0.8;
  brainAuraMat.opacity = Math.max(0, brainAuraMat.opacity - dt * 0.35);
  brainAura.rotation.y += dt * 2.5;
  senseRingMat.opacity = Math.max(0, senseRingMat.opacity - dt * 0.35);
